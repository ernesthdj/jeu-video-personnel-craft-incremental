<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests "EditMode" au sens Unity Test Framework (tests de GameCore, sans Play Mode ni
    scène) — voir docs/PROJECT-STRUCTURE.md §1. Exécutés ici via xUnit + dotnet test, en
    dehors de Unity (non installé dans cet environnement d'agent). Quand un vrai projet
    Unity sera ouvert, ces mêmes fichiers .cs peuvent être portés vers le Unity Test
    Framework (NUnit, [Test]/[TestFixture]) — voir docs/IMPLEMENTATION.md pour le détail
    de cette limitation connue.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Game.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\UnityProject\Assets\_Project\GameCore\GameCore.csproj" />
  </ItemGroup>

</Project>
